{
  "name": "cheshers-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, ad-free Cheshers multiplayer backend",
  "engines": { "node": ">=20 <26" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
